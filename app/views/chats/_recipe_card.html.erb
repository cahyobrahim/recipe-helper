<article class="recipe-card"
         data-controller="cook-mode clipboard servings"
         data-cook-mode-steps-value="<%= recipe.steps.to_json %>"
         data-clipboard-text-value="<%= recipe.to_plain_text %>"
         data-servings-name-value="<%= recipe.name %>"
         data-servings-time-value="<%= recipe.time %>"
         data-servings-servings-value="<%= recipe.servings || 1 %>"
         data-servings-ingredients-value="<%= recipe.ingredients.map { |item| { name: item.name, quantity: item.quantity, unit: item.unit } }.to_json %>"
         data-servings-missing-value="<%= recipe.missing.to_json %>"
         data-servings-steps-value="<%= recipe.steps.to_json %>">
  <header class="flex items-start gap-3">
    <span class="rank-badge" aria-hidden="true"><%= recipe_counter + 1 %></span>
    <div class="min-w-0 flex-1">
      <h3 class="font-display text-xl font-bold leading-tight text-wood-900"><%= recipe.name %></h3>
      <% if recipe.time.present? %>
        <p class="mt-2"><span class="time-pill">⏱ <%= recipe.time %></span></p>
      <% end %>
    </div>
  </header>

  <% if recipe.ingredients.any? %>
    <section class="mt-5 rounded-xl border border-wood-100 bg-cream-50 p-4" aria-label="Ingredients and servings">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-wood-500">Ingredients</p>
        <label class="no-print flex items-center gap-2 text-sm font-medium text-wood-700">
          Servings
          <select class="min-h-11 rounded-lg border border-wood-200 bg-white px-3 text-sm font-semibold text-wood-800"
                  data-servings-target="select"
                  data-action="change->servings#change">
            <% (1..[ 12, recipe.servings.to_i + 4 ].max).each do |count| %>
              <option value="<%= count %>" <%= "selected" if count == recipe.servings.to_i %>><%= count %></option>
            <% end %>
          </select>
        </label>
      </div>
      <ul class="mt-3 space-y-2 text-sm text-wood-800" data-servings-target="ingredients">
        <% recipe.ingredients.each do |ingredient| %>
          <li class="flex gap-2">
            <span class="w-20 shrink-0 font-semibold text-wood-900"><%= ingredient.display_amount %></span>
            <span><%= ingredient.name %></span>
          </li>
        <% end %>
      </ul>
      <p class="sr-only" role="status" aria-live="polite" data-servings-target="announcement"></p>
    </section>
  <% elsif recipe.uses.any? %>
    <div class="mt-5">
      <p class="text-xs font-semibold uppercase tracking-wider text-wood-500">Uses your</p>
      <div class="mt-2 flex flex-wrap gap-1.5">
        <% recipe.uses.each do |item| %>
          <span class="mini-chip"><%= item %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <p class="mt-4 text-sm text-wood-600">
    <% if recipe.missing.any? %>
      <span class="font-semibold text-wood-700">Optional extras:</span> <%= recipe.missing.join(", ") %>
    <% else %>
      <span class="text-herb-600">No extras needed — you're all set.</span>
    <% end %>
  </p>

  <% if recipe.steps.any? %>
    <ol class="mt-5 space-y-3">
      <% recipe.steps.each_with_index do |step, index| %>
        <li class="flex gap-3 text-sm leading-relaxed text-wood-800">
          <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-cream-200 text-xs font-bold text-wood-700" aria-hidden="true"><%= index + 1 %></span>
          <span><%= step %></span>
        </li>
      <% end %>
    </ol>
  <% end %>

  <div class="no-print mt-6 flex flex-wrap gap-2 border-t border-wood-100 pt-4">
    <% if recipe.steps.any? %>
      <button type="button" class="btn-secondary" data-action="click->cook-mode#start">Cook mode</button>
    <% end %>
    <button type="button" class="btn-secondary" data-action="click->clipboard#copy">Copy</button>
    <button type="button" class="btn-secondary" data-action="click->clipboard#print">Print</button>
  </div>

  <% if recipe.steps.any? %>
    <div data-cook-mode-target="panel" role="region" aria-label="Cook mode"
         class="no-print mt-6 hidden rounded-2xl bg-wood-800 p-5 text-cream-50">
      <p class="text-xs font-semibold uppercase tracking-widest text-wood-200" data-cook-mode-target="counter"></p>
      <p class="mt-3 font-display text-2xl leading-snug" data-cook-mode-target="step"></p>
      <p class="sr-only" role="status" aria-live="polite" data-cook-mode-target="announcement"></p>
      <div class="mt-6 flex flex-wrap gap-2">
        <button type="button" class="btn-secondary" data-action="click->cook-mode#prev" data-cook-mode-target="prev">← Back</button>
        <button type="button" class="btn-primary flex-1" data-action="click->cook-mode#next" data-cook-mode-target="next">Next step →</button>
        <button type="button" class="btn-secondary" data-action="click->cook-mode#finish">Done</button>
      </div>
    </div>
  <% end %>
</article>
