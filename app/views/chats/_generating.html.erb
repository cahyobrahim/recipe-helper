<div class="text-center">
  <p class="mb-2 font-display text-xl text-wood-700" data-recipe-status-target="message">
    Cooking up some ideas…
  </p>
  <p class="text-sm text-wood-500">This can take up to a minute. Feel free to leave this tab open.</p>
  <div class="mt-6 grid gap-4 text-left sm:grid-cols-2" aria-hidden="true">
    <% 2.times do %>
      <div class="recipe-card">
        <div class="skeleton h-6 w-2/3"></div>
        <div class="skeleton mt-4 h-4 w-1/3"></div>
        <div class="skeleton mt-6 h-3 w-full"></div>
        <div class="skeleton mt-2 h-3 w-5/6"></div>
        <div class="skeleton mt-2 h-3 w-4/6"></div>
      </div>
    <% end %>
  </div>
</div>
