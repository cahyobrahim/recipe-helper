<section class="section-card text-center" role="alert" data-recipe-status="error">
  <span class="text-4xl" aria-hidden="true">🧑‍🍳</span>
  <h2 class="mt-3 font-display text-2xl font-bold">We couldn't find recipes just yet</h2>
  <p class="mx-auto mt-2 max-w-lg leading-relaxed text-wood-600">
    <%= message.presence || "Gemini is slow or busy right now. Please try again in a minute." %>
  </p>
  <a href="#ingredient-search" class="btn-primary mt-6">Try again</a>
</section>
