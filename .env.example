# Copy this file to .env and fill in your key (the .env file is gitignored).
GEMINI_API_KEY=

# Comma-separated list of models to try in order (optional).
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash

# Cost controls for Gemini generation (optional).
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# Recipe endpoint throttle defaults (seconds). Optional.
CHAT_IP_LIMIT=10
CHAT_IP_PERIOD=3600
CHAT_GLOBAL_LIMIT=100
CHAT_GLOBAL_PERIOD=3600
# Set to false to bypass throttling in an emergency.
RACK_ATTACK_ENABLED=true

# Production only: app cache DB 0, Rack::Attack uses DB 1.
# REDIS_URL=redis://localhost:6379/0
